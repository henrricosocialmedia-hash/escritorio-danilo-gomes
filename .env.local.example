# Supabase - pegue em: https://app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Z-API - pegue em: https://app.z-api.io > Sua Instância > Credenciais
ZAPI_INSTANCE_ID=seu_instance_id
ZAPI_TOKEN=seu_token
ZAPI_CLIENT_TOKEN=seu_client_token

# Supabase service role key (Settings > API > service_role) - SOMENTE no servidor/Vercel, nunca no navegador
# Usada para criar acessos aprovados, gravar o log de WhatsApp e rodar o cron de aniversários
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Segredo do cron de aniversários (qualquer texto longo e aleatório). A Vercel o envia sozinha ao chamar o cron
CRON_SECRET=um_texto_longo_e_aleatorio
